  void _openFolder(Map<String, dynamic> item) {
    final id = int.tryParse('${item['id'] ?? 0}') ?? 0;
    if (id <= 0) return;
    setState(() {
      _parentId = id;
      _crumbs.add(<String, dynamic>{
        'id': id,
        'name': '${item['name'] ?? 'Папка'}',
      });
      _search.clear();
      _searchText = '';
    });
    _load();
  }

  Future<void> _goBack() async {
    if (_category == null) {
      if (widget.onCancel != null) {
        widget.onCancel!();
      } else {
        Navigator.of(context).maybePop();
      }
      return;
    }
    if (_crumbs.length <= 1) {
      _goHome();
      return;
    }
    setState(() {
      _crumbs.removeLast();
      final id = _crumbs.last['id'];
      final parsed = id is int ? id : int.tryParse('$id');
      _parentId = parsed != null && parsed > 0 ? parsed : null;
      _search.clear();
      _searchText = '';
    });
    await _load();
  }

  Future<String?> _askText(String title, {String initial = ''}) async {
    final controller = TextEditingController(text: initial);
    final result = await showDialog<String>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        title: Text(title),
        content: TextField(
          controller: controller,
          autofocus: true,
          decoration: const InputDecoration(hintText: 'Название'),
          onSubmitted: (value) =>
              Navigator.pop(dialogContext, value.trim()),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(dialogContext),
            child: const Text('Отмена'),
          ),
          TextButton(
            onPressed: () =>
                Navigator.pop(dialogContext, controller.text.trim()),
            child: const Text('Сохранить'),
          ),
        ],
      ),
    );
    controller.dispose();
    return result?.trim();
  }

  Future<void> _createFolder() async {
    if (_category == null || _busy) return;
    final name = await _askText('Новая папка');
    if (name == null || name.isEmpty) return;
    setState(() => _busy = true);
    final data = await _post('create_folder.php', <String, String>{
      'user_id': '$_userId',
      'category': _category!,
      'name': name,
      if (_parentId != null) 'parent_id': '$_parentId',
    });
    if (mounted) setState(() => _busy = false);
    if (data['success'] == true) {
      await _load();
    } else {
      _snack('${data['message'] ?? 'Не удалось создать папку'}');
    }
  }

  Future<void> _createDocument() async {
    if (_category == null || _busy || widget.selectionMode) return;
    final titleCtrl = TextEditingController();
    final bodyCtrl = TextEditingController();
    final ok = await showDialog<bool>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        title: const Text('Новый документ'),
        content: SizedBox(
          width: 520,
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              TextField(
                controller: titleCtrl,
                autofocus: true,
                decoration: const InputDecoration(labelText: 'Название'),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: bodyCtrl,
                maxLines: 8,
                decoration: const InputDecoration(
                  labelText: 'Текст документа',
                  alignLabelWithHint: true,
                ),
              ),
            ],
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(dialogContext, false),
            child: const Text('Отмена'),
          ),
          TextButton(
            onPressed: () => Navigator.pop(dialogContext, true),
            child: const Text('Создать'),
          ),
        ],
      ),
    );
    final name = titleCtrl.text.trim();
    final body = bodyCtrl.text;
    titleCtrl.dispose();
    bodyCtrl.dispose();
    if (ok != true || name.isEmpty) return;
    setState(() => _busy = true);
    final data = await _post('create_document.php', <String, String>{
      'user_id': '$_userId',
      'category': _category!,
      'name': name,
      'content': body,
      if (_parentId != null) 'parent_id': '$_parentId',
    });
    if (mounted) setState(() => _busy = false);
    if (data['success'] == true) {
      await _load();
    } else {
      _snack('${data['message'] ?? 'Не удалось создать документ'}');
    }
  }

  Future<void> _upload() async {
    if (_category == null || _busy || kIsWeb || widget.selectionMode) return;
    final result = await FilePicker.pickFiles(withData: false);
    if (result == null || result.files.isEmpty) return;
    final path = result.files.single.path;
    if (path == null || path.isEmpty) return;
    setState(() => _busy = true);
    try {
      final request = http.MultipartRequest(
        'POST',
        Uri.parse('$_base/upload.php'),
      )
        ..fields['user_id'] = '$_userId'
        ..fields['category'] = _category!;
      if (_parentId != null) request.fields['parent_id'] = '$_parentId';
      request.files.add(await http.MultipartFile.fromPath('file', path));
      final streamed = await request.send().timeout(const Duration(minutes: 3));
      final response = await http.Response.fromStream(streamed);
      final data = _decode(response);
      if (data['success'] == true) {
        await _load();
      } else {
        _snack('${data['message'] ?? 'Не удалось загрузить файл'}');
      }
    } catch (e) {
      _snack('Не удалось загрузить файл: $e');
    } finally {
      if (mounted) setState(() => _busy = false);
    }
  }

  Future<void> _rename(Map<String, dynamic> item) async {
    final id = int.tryParse('${item['id'] ?? 0}') ?? 0;
    if (id <= 0) return;
    final name = await _askText(
      'Переименовать',
      initial: '${item['name'] ?? ''}',
    );
    if (name == null || name.isEmpty) return;
    final data = await _post('rename.php', <String, String>{
      'user_id': '$_userId',
      'id': '$id',
      'name': name,
    });
    if (data['success'] == true) {
      await _load();
    } else {
      _snack('${data['message'] ?? 'Не удалось переименовать'}');
    }
  }

  Future<void> _delete(Map<String, dynamic> item) async {
    final id = int.tryParse('${item['id'] ?? 0}') ?? 0;
    if (id <= 0) return;
    final ok = await showDialog<bool>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        title: const Text('Удалить?'),
        content: Text('«${item['name'] ?? ''}» будет удалено из личной Sportoteka OS.'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(dialogContext, false),
            child: const Text('Отмена'),
          ),
          TextButton(
            onPressed: () => Navigator.pop(dialogContext, true),
            child: const Text('Удалить'),
          ),
        ],
      ),
    );
    if (ok != true) return;
    final data = await _post('delete.php', <String, String>{
      'user_id': '$_userId',
      'id': '$id',
    });
    if (data['success'] == true) {
      await _load();
    } else {
      _snack('${data['message'] ?? 'Не удалось удалить'}');
    }
  }

