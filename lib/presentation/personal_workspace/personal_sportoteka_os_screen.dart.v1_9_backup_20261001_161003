  Future<void> _boot() async {
    _userId = await PrefUtils.getUserId() ?? 0;
    final first = await PrefUtils.getUserFirstName();
    final last = await PrefUtils.getUserLastName();
    final name = '$first $last'.trim();
    if (name.isNotEmpty) _ownerName = name;

    await _loadModules();

    final initial = (widget.initialCategory ?? '').trim();
    if (initial.isNotEmpty) {
      final section = _sectionFor(initial);
      if (section != null && _sectionUnlocked(section)) {
        _category = initial;
        _categoryName = (widget.initialCategoryName ?? '').trim().isNotEmpty
            ? widget.initialCategoryName!.trim()
            : section.title;
        final initialFolderId = widget.initialFolderId ?? 0;
        _parentId = initialFolderId > 0 ? initialFolderId : null;
        _crumbs
          ..clear()
          ..add(<String, dynamic>{'id': null, 'name': _categoryName});
        if (initialFolderId > 0) {
          final folderTitle = (widget.initialFolderTitle ?? '').trim();
          _crumbs.add(<String, dynamic>{
            'id': initialFolderId,
            'name': folderTitle.isEmpty ? 'Выбранная папка' : folderTitle,
          });
        }
      }
    }
    await _load();
  }

  Future<void> _loadModules() async {
    if (_userId <= 0) {
      if (mounted) setState(() => _modulesLoading = false);
      return;
    }
    final result = await PersonalModuleService.status(userId: _userId);
    if (!mounted) return;
    _moduleByCode.clear();
    if (result['success'] == true) {
      for (final item in PersonalModuleService.modules(result)) {
        final code = '${item['module_code'] ?? ''}'.trim();
        if (code.isNotEmpty) _moduleByCode[code] = item;
      }
    }
    setState(() => _modulesLoading = false);
  }

  _PersonalOsSection? _sectionFor(String category) {
    for (final section in _sections) {
      if (section.category == category) return section;
    }
    return null;
  }

  bool _moduleUnlocked(String code) {
    final item = _moduleByCode[code];
    if (item == null) return false;
    final state = '${item['state'] ?? ''}'.trim().toLowerCase();
    return item['has_access'] == true || state == 'active' || state == 'free';
  }

  bool _modulePending(String code) {
    final item = _moduleByCode[code];
    if (item == null) return false;
    final state = '${item['state'] ?? ''}'.trim().toLowerCase();
    return state == 'pending' || state == 'requested' ||
        item['request_status'] == 'pending';
  }

  bool _sectionUnlocked(_PersonalOsSection section) {
    if (section.moduleCodes.isEmpty) return true;
    if (widget.selectionMode &&
        (widget.selectionCategory ?? '').trim() == section.category) {
      // The caller already passed the module entitlement gate. Do not block a
      // save operation just because the status refresh is temporarily offline.
      return true;
    }
    return section.moduleCodes.any(_moduleUnlocked);
  }

  bool _sectionPending(_PersonalOsSection section) {
    if (_sectionUnlocked(section)) return false;
    return section.moduleCodes.any(_modulePending);
  }

  String _moduleTitle(String code) {
    final item = _moduleByCode[code];
    final title = '${item?['title'] ?? item?['name'] ?? ''}'.trim();
    return title.isNotEmpty ? title : (_fallbackModuleTitles[code] ?? code);
  }

  int _modulePrice(String code) {
    final item = _moduleByCode[code];
    final raw = item?['price_monthly_byn'] ?? item?['price_byn'];
    if (raw is num) return raw.round();
    return int.tryParse('${raw ?? ''}') ?? (_fallbackPrices[code] ?? 0);
  }

  Map<String, dynamic> _decode(http.Response response) {
    final raw = utf8.decode(response.bodyBytes, allowMalformed: true).trim();
    if (raw.isEmpty) {
      return <String, dynamic>{
        'success': false,
        'message': 'Сервер вернул пустой ответ · HTTP ${response.statusCode}',
      };
    }
    if (raw.startsWith('<') || raw.toLowerCase().contains('<html')) {
      return <String, dynamic>{
        'success': false,
        'message': 'Sportoteka OS API недоступен · HTTP ${response.statusCode}',
      };
    }
    try {
      final value = jsonDecode(raw);
      if (value is Map) return Map<String, dynamic>.from(value);
    } catch (_) {}
    return <String, dynamic>{
      'success': false,
      'message': 'Некорректный ответ Sportoteka OS · HTTP ${response.statusCode}',
    };
  }

  Future<Map<String, dynamic>> _post(
    String endpoint,
    Map<String, String> body,
  ) async {
    try {
      final response = await http
          .post(Uri.parse('$_base/$endpoint'), body: body)
          .timeout(const Duration(seconds: 20));
      return _decode(response);
    } catch (e) {
      return <String, dynamic>{
        'success': false,
        'message': 'Ошибка соединения: $e',
      };
    }
  }

  Future<void> _load() async {
    if (!mounted) return;
    if (_userId <= 0) {
      setState(() {
        _loading = false;
        _error = 'Не удалось определить пользователя';
      });
      return;
    }

    if (_category == null) {
      setState(() {
        _loading = false;
        _error = null;
        _items = <Map<String, dynamic>>[];
      });
      return;
    }

    final section = _sectionFor(_category!);
    if (section != null && !_sectionUnlocked(section)) {
      setState(() {
        _loading = false;
        _error = null;
        _items = <Map<String, dynamic>>[];
      });
      return;
    }

    setState(() {
      _loading = true;
      _error = null;
    });

    final body = <String, String>{
      'user_id': '$_userId',
      'category': _category!,
      if (_parentId != null) 'parent_id': '$_parentId',
    };
    final data = await _post('list.php', body);
    if (!mounted) return;
    if (data['success'] == true) {
      setState(() {
        _items = data['items'] is List
            ? (data['items'] as List)
                .whereType<Map>()
                .map((e) => Map<String, dynamic>.from(e))
                .toList()
            : <Map<String, dynamic>>[];
        _loading = false;
      });
    } else {
      setState(() {
        _loading = false;
        _error = '${data['message'] ?? 'Не удалось загрузить Sportoteka OS'}';
      });
    }
  }

  Future<void> _openSection(_PersonalOsSection section) async {
    if (!_sectionUnlocked(section)) {
      await _showModuleAccess(section);
      return;
    }
    setState(() {
      _category = section.category;
      _categoryName = section.title;
      _parentId = null;
      _crumbs
        ..clear()
        ..add(<String, dynamic>{'id': null, 'name': section.title});
      _search.clear();
      _searchText = '';
      _showSidebarOnCompact = false;
    });
    await _load();
  }

  Future<void> _showModuleAccess(_PersonalOsSection section) async {
    if (_sectionPending(section)) {
      _snack('Заявка на модуль уже отправлена.');
      return;
    }

    final lockedCodes = section.moduleCodes
        .where((code) => !_moduleUnlocked(code))
        .toList(growable: false);
    if (lockedCodes.isEmpty) return;

    await showModalBottomSheet<void>(
      context: context,
      backgroundColor: Colors.white,
      barrierColor: Colors.black.withOpacity(.20),
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(22)),
      ),
      builder: (sheetContext) {
        return SafeArea(
          top: false,
          child: Padding(
            padding: const EdgeInsets.fromLTRB(20, 16, 20, 18),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                Row(
                  children: [
                    const Icon(Icons.lock_outline_rounded, size: 19),
                    const SizedBox(width: 9),
                    Expanded(
                      child: Text(
                        section.title,
                        style: AppTypography.itemTitle(color: _text),
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 6),
                Text(
                  lockedCodes.length == 1
                      ? 'Подключите модуль, чтобы открыть этот раздел в личной Sportoteka OS.'
                      : 'Выберите модуль, который хотите подключить.',
                  style: AppTypography.secondary(color: _muted),
                ),
                const SizedBox(height: 14),
                for (final code in lockedCodes)
                  Container(
                    decoration: const BoxDecoration(
                      border: Border(bottom: BorderSide(color: _line)),
                    ),
                    child: ListTile(
                      contentPadding: EdgeInsets.zero,
                      title: Text(
                        _moduleTitle(code),
                        style: AppTypography.menuTitle(color: _text),
                      ),
                      subtitle: Text(
                        _modulePrice(code) > 0
                            ? '${_modulePrice(code)} BYN / мес.'
                            : 'По заявке',
                        style: AppTypography.caption(color: _muted),
                      ),
                      trailing: OutlinedButton(
                        onPressed: () async {
                          Navigator.of(sheetContext).pop();
                          await _requestModule(code);
                        },
                        child: const Text('Подключить'),
                      ),
                    ),
                  ),
              ],
            ),
          ),
        );
      },
    );
  }

  Future<void> _requestModule(String code) async {
    if (_userId <= 0) return;
    setState(() => _busy = true);
    final result = await PersonalModuleService.request(
      userId: _userId,
      moduleCode: code,
      source: 'personal_sportoteka_os',
    );
    if (mounted) setState(() => _busy = false);
    if (result['success'] == true) {
      _snack('Заявка отправлена: ${_moduleTitle(code)}');
      await _loadModules();
    } else {
      _snack('${result['message'] ?? 'Не удалось отправить заявку'}');
    }
  }

