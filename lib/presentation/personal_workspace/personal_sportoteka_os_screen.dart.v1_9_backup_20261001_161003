  Widget _buildBreadcrumbs() {
    if (_category == null) {
      return const SizedBox(height: 8);
    }
    return Container(
      height: 48,
      padding: const EdgeInsets.symmetric(horizontal: 20),
      alignment: Alignment.centerLeft,
      child: Row(
        children: [
          Expanded(
            child: ListView.separated(
              scrollDirection: Axis.horizontal,
              itemCount: _crumbs.length,
              separatorBuilder: (_, __) => const Padding(
                padding: EdgeInsets.symmetric(horizontal: 4),
                child: Icon(Icons.chevron_right_rounded, size: 16, color: _muted),
              ),
              itemBuilder: (context, index) {
                final active = index == _crumbs.length - 1;
                return InkWell(
                  onTap: active
                      ? null
                      : () async {
                          setState(() {
                            _crumbs.removeRange(index + 1, _crumbs.length);
                            final id = _crumbs[index]['id'];
                            final parsed = id is int ? id : int.tryParse('$id');
                            _parentId = parsed != null && parsed > 0 ? parsed : null;
                          });
                          await _load();
                        },
                  child: Padding(
                    padding: const EdgeInsets.symmetric(horizontal: 3, vertical: 5),
                    child: Text(
                      '${_crumbs[index]['name'] ?? _categoryName}',
                      style: active
                          ? AppTypography.itemTitle(color: _text)
                          : AppTypography.secondary(color: _muted),
                    ),
                  ),
                );
              },
            ),
          ),
          if (widget.selectionMode &&
              (widget.selectionCategory ?? '').trim().isNotEmpty &&
              _category != widget.selectionCategory)
            Text(
              'Сохранение: ${_sectionFor(widget.selectionCategory!)?.title ?? widget.selectionCategory}',
              style: AppTypography.caption(color: _muted),
            ),
        ],
      ),
    );
  }

