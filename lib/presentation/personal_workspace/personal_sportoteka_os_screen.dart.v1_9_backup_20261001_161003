  bool get _canSelectCurrentFolder {
    if (!widget.selectionMode || _category == null) return false;
    final requiredCategory = (widget.selectionCategory ?? '').trim();
    if (requiredCategory.isEmpty) return true;
    return _category == requiredCategory;
  }

  void _selectCurrentFolder() {
    if (!_canSelectCurrentFolder) {
      final requiredCategory = (widget.selectionCategory ?? '').trim();
      final section = _sectionFor(requiredCategory);
      _snack(
        section == null
            ? 'Выберите подходящий раздел.'
            : 'Для этого материала выберите папку в разделе «${section.title}».',
      );
      return;
    }
    final value = <String, dynamic>{
      'id': _parentId ?? 0,
      'title': _crumbs.isNotEmpty
          ? '${_crumbs.last['name'] ?? _categoryName}'
          : _categoryName,
      'category': _category,
    };
    if (widget.onFolderSelected != null) {
      widget.onFolderSelected!(value);
    } else {
      Navigator.of(context).pop(value);
    }
  }

  void _snack(String message) {
    if (!mounted) return;
    final messenger = ScaffoldMessenger.of(context);
    messenger.hideCurrentSnackBar();
    messenger.showSnackBar(
      SnackBar(
        content: Text(message),
        behavior: SnackBarBehavior.floating,
      ),
    );
  }

  List<Map<String, dynamic>> get _visibleItems {
    final query = _searchText.trim().toLowerCase();
    if (query.isEmpty) return _items;
    return _items.where((item) {
      return '${item['name'] ?? ''}'.toLowerCase().contains(query);
    }).toList(growable: false);
  }

  IconData _iconForItem(Map<String, dynamic> item) {
    final kind = '${item['kind'] ?? ''}';
    if (kind == 'folder') return Icons.folder_outlined;
    if (kind == 'document') return Icons.description_outlined;
    final mime = '${item['mime_type'] ?? ''}'.toLowerCase();
    if (mime.startsWith('image/')) return Icons.image_outlined;
    if (mime.startsWith('video/')) return Icons.movie_outlined;
    if (mime.contains('pdf')) return Icons.picture_as_pdf_outlined;
    return Icons.insert_drive_file_outlined;
  }

