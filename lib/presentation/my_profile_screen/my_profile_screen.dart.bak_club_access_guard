      bodyFontSize: (json['bodyFontSize'] as num?)?.toDouble() ?? 14,
      smallFontSize: (json['smallFontSize'] as num?)?.toDouble() ?? 12,
      titleWeight: _parseFontWeight((json['titleWeight'] ?? 'w900').toString()),
