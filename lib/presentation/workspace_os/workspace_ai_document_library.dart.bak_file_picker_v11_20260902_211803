                      child: Text(
                        'Анализ SPORTOTEKA AI',
                        style: TextStyle(
                          color: _text,
                          fontSize: 14,
                          fontWeight: FontWeight.w800,
                        ),
                      ),
                    ),
                    TextButton.icon(
                      onPressed: _analyzing ? null : _reanalyze,
                      icon: _analyzing
                          ? const SizedBox(
                              width: 14,
                              height: 14,
                              child: CircularProgressIndicator(
                                strokeWidth: 2,
                              ),
                            )
                          : const Icon(Icons.auto_awesome_rounded, size: 17),
                      label: const Text('Обновить анализ'),
                    ),
                  ],
                ),
                const SizedBox(height: 8),
                _panel(
                  child: Text(
                    '${row['analysis'] ?? 'Анализ пока не создан.'}',
                    style: const TextStyle(
                      color: _text,
                      fontSize: 13,
                      height: 1.5,
                    ),
                  ),
                ),
                const SizedBox(height: 18),
                const Text(
                  'Спросить AI по документу',
                  style: TextStyle(
                    color: _text,
                    fontSize: 14,
                    fontWeight: FontWeight.w800,
                  ),
                ),
                const SizedBox(height: 8),
                Row(
                  children: <Widget>[
                    Expanded(
                      child: TextField(
                        controller: _question,
                        minLines: 1,
                        maxLines: 4,
                        onSubmitted: (_) => unawaited(_ask()),
                        decoration: InputDecoration(
                          hintText: 'Например: выдели упражнения или сопоставь '
                              'методику с последней тренировкой команды…',
                          filled: true,
                          fillColor: Colors.white,
                          border: OutlineInputBorder(
                            borderRadius: BorderRadius.circular(13),
                            borderSide: const BorderSide(color: _line),
                          ),
                          enabledBorder: OutlineInputBorder(
                            borderRadius: BorderRadius.circular(13),
                            borderSide: const BorderSide(color: _line),
                          ),
                        ),
                      ),
                    ),
                    const SizedBox(width: 8),
                    SizedBox(
                      width: 46,
                      height: 46,
                      child: FilledButton(
                        onPressed: _asking ? null : _ask,
                        style: FilledButton.styleFrom(
                          padding: EdgeInsets.zero,
                          backgroundColor: _green,
                          foregroundColor: Colors.white,
                        ),
                        child: _asking
                            ? const SizedBox(
                                width: 18,
                                height: 18,
                                child: CircularProgressIndicator(
                                  strokeWidth: 2,
                                  color: Colors.white,
                                ),
                              )
                            : const Icon(Icons.arrow_upward_rounded),
                      ),
                    ),
                  ],
                ),
                if (_answer.isNotEmpty) ...<Widget>[
                  const SizedBox(height: 12),
                  _panel(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: <Widget>[
                        const Row(
                          children: <Widget>[
                            Icon(
                              Icons.auto_awesome_rounded,
                              color: _greenDark,
                              size: 18,
                            ),
                            SizedBox(width: 7),
                            Text(
                              'Ответ AI',
                              style: TextStyle(
                                color: _text,
                                fontSize: 12.5,
                                fontWeight: FontWeight.w800,
                              ),
                            ),
                          ],
                        ),
                        const SizedBox(height: 9),
                        Text(
                          _answer,
                          style: const TextStyle(
                            color: _text,
                            fontSize: 13,
                            height: 1.5,
                          ),
                        ),
                        if (_sources.isNotEmpty) ...<Widget>[
                          const SizedBox(height: 12),
                          const Divider(color: _line),
                          const SizedBox(height: 7),
                          const Text(
                            'Использованные фрагменты',
                            style: TextStyle(
                              color: _muted,
                              fontSize: 10.8,
                              fontWeight: FontWeight.w700,
                            ),
                          ),
                          const SizedBox(height: 6),
                          ..._sources.take(6).map(
                                (source) => Padding(
                                  padding: const EdgeInsets.only(bottom: 5),
                                  child: Text(
                                    '• ${source['filename'] ?? ''} · '
                                    'фрагмент ${source['chunk_index'] ?? ''}',
                                    style: const TextStyle(
                                      color: _muted,
                                      fontSize: 10.8,
                                    ),
                                  ),
                                ),
                              ),
                        ],
                      ],
                    ),
                  ),
                ],
                const SizedBox(height: 18),
                ExpansionTile(
                  tilePadding: EdgeInsets.zero,
                  title: const Text(
                    'Извлечённый текст',
                    style: TextStyle(
                      color: _text,
                      fontSize: 13,
                      fontWeight: FontWeight.w700,
                    ),
                  ),
                  subtitle: Text(
                    '${row['text_chars'] ?? 0} символов · '
                    '${row['chunks_count'] ?? 0} фрагментов',
                    style: const TextStyle(
                      color: _muted,
                      fontSize: 10.8,
                    ),
                  ),
                  children: <Widget>[
                    _panel(
                      child: SelectableText(
                        _textPreview.isEmpty
                            ? 'Текст не извлечён.'
                            : _textPreview,
                        style: const TextStyle(
                          color: _text,
                          fontSize: 12.2,
                          height: 1.45,
                        ),
                      ),
                    ),
                  ],
                ),
              ],
            ),
          ),
        ),
        if (_error != null)
          Container(
            width: double.infinity,
            padding: const EdgeInsets.symmetric(
              horizontal: 14,
              vertical: 9,
            ),
            color: const Color(0xFFFFF4E5),
            child: Text(
              _error!,
              style: const TextStyle(
                color: Color(0xFFB54708),
                fontSize: 11.5,
              ),
            ),
          ),
      ],
    );
  }

  Widget _panel({required Widget child}) {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(13),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: _line),
      ),
      child: child,
    );
  }

  @override
  Widget build(BuildContext context) {
    final width = MediaQuery.sizeOf(context).width;
    final compact = width < 780;

    return Material(
      color: _bg,
      child: SafeArea(
        child: Column(
          children: <Widget>[
            Container(
              padding: const EdgeInsets.fromLTRB(14, 10, 14, 10),
              decoration: const BoxDecoration(
                color: Colors.white,
                border: Border(bottom: BorderSide(color: _line)),
              ),
              child: Row(
                children: <Widget>[
                  if (widget.onClose != null)
                    IconButton(
                      onPressed: widget.onClose,
                      icon: const Icon(Icons.arrow_back_rounded),
                    ),
                  const Icon(
                    Icons.folder_copy_outlined,
                    color: _greenDark,
                    size: 21,
                  ),
                  const SizedBox(width: 8),
                  const Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: <Widget>[
                        Text(
                          'Методические материалы AI',
                          style: TextStyle(
                            color: _text,
                            fontSize: 16,
                            fontWeight: FontWeight.w800,
                          ),
                        ),
                        Text(
                          'Документы клуба · чтение · анализ · вопросы',
                          style: TextStyle(
                            color: _muted,
                            fontSize: 10.8,
                          ),
                        ),
                      ],
                    ),
                  ),
                ],
              ),
            ),
            Expanded(
              child: compact
                  ? Column(
                      children: <Widget>[
                        SizedBox(
                          height: 290,
                          child: _documentList(true),
                        ),
                        const Divider(height: 1, color: _line),
                        Expanded(child: _detail()),
                      ],
                    )
                  : Row(
                      children: <Widget>[
                        _documentList(false),
                        Expanded(child: _detail()),
                      ],
                    ),
            ),
          ],
        ),
      ),
    );
  }
}
