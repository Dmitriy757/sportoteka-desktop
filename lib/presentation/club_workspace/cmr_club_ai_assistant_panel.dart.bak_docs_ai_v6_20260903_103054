                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text('История SPORTOTEKA ИИ',
                                    style: _AiText.title(17.0)),
                                const SizedBox(height: 3),
                                Text(
                                  'Сохраняется на сервере для этого пользователя',
                                  style: _AiText.muted(12.0),
                                ),
                              ],
                            ),
                          ),
