          'club_id': widget.clubId.toString(),
          'user_id': widget.userId.toString(),
          if ((widget.teamId ?? 0) > 0) 'team_id': widget.teamId.toString(),
          'query_id': message.queryId.toString(),
          'rating': rating.toString(),
          'comment': comment,
