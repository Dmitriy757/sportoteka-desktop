class _CmrGlowDot extends StatelessWidget {
  final Color color;
  final double size;
  final double opacity;
  final bool halo;

  const _CmrGlowDot({
    super.key,
    required this.color,
    this.size = 6,
    this.opacity = 1,
    this.halo = true,
  });

  @override
  Widget build(BuildContext context) {
    return Opacity(
      opacity: opacity,
      child: Container(
        width: size,
        height: size,
        decoration: BoxDecoration(
          color: color,
          shape: BoxShape.circle,
          boxShadow: halo
              ? <BoxShadow>[
                  BoxShadow(
                    color: color.withOpacity(.16),
                    blurRadius: size * 1.7,
                    spreadRadius: .15,
                  ),
                  BoxShadow(
                    color: color.withOpacity(.055),
                    blurRadius: size * 2.8,
                    spreadRadius: .35,
                  ),
                ]
              : null,
        ),
      ),
    );
  }
}

