  final String Function(Map<String, dynamic>) trainerNameOf;
  final String Function(Map<String, dynamic>) trainerEmailOf;
  final String Function(Map<String, dynamic>) trainerPhotoOf;
  final int Function(Map<String, dynamic>) teamIdOf;
  final String Function(Map<String, dynamic>) teamNameOf;

  final VoidCallback onClose;

  final Future<List<Map<String, dynamic>>> Function(
    String email,
  ) onSearch;

  final Future<bool> Function(
    Map<String, dynamic> trainer,
  ) onAddClub;

  final Future<bool> Function(
    Map<String, dynamic> trainer,
    int teamId,
    String profile,
  ) onAssignTeam;

  const _TrainerAddRightPanel({
    required this.clubName,
    required this.teams,
    required this.pressMode,
    required this.saving,
    required this.trainerIdOf,
    required this.trainerNameOf,
